TZ=Europe/Amsterdam
BUILD_VERSION=next-dev

# Change this before first start.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=discvault_next
POSTGRES_USER=discvault_next

# Dev image built from the codex/discvault-next branch.
DISCVAULT_NEXT_IMAGE=ghcr.io/helmerznl/discvault:dev

# Existing DiscVault data directory on the Docker host. This is mounted as /data
# so Next can read /data/discvault.db and keep existing media files in place.
DISCVAULT_DATA_DIR=/mnt/user/appdata/discvault

# Host port for the Next API.
DISCVAULT_NEXT_API_PORT=6180
DISCVAULT_NEXT_API_WORKERS=2
DISCVAULT_NEXT_API_TIMEOUT=180

# Passkeys and session tokens. Use a long stable random JWT_SECRET.
# RP_ID must be the browser hostname without scheme or port.
JWT_SECRET=change-me-to-a-long-random-session-secret
RP_ID=appdev.discvault.eu
RP_NAME=DiscVault
RP_ORIGINS=https://appdev.discvault.eu

# Worker identity shown in job results.
DISCVAULT_WORKER_ID=next-worker-1
DISCVAULT_WORKER_POLL_INTERVAL=2
