{
  "id": "discvault_legacy_import",
  "name": "DiscVault Legacy Import",
  "version": "1.0.0",
  "manifestVersion": 1,
  "discVaultPluginApi": "next-1",
  "categories": ["import_source"],
  "capabilities": [
    "inspect_source",
    "plan_import",
    "import_collection",
    "import_security_backfill",
    "reference_existing_media"
  ],
  "defaultEnabled": true,
  "requiresSecrets": false,
  "settingsSchemaVersion": 1,
  "settingsSchema": {
    "settings": [
      {
        "name": "dataDir",
        "label": "Legacy data directory",
        "type": "text",
        "required": false,
        "placeholder": "/data",
        "description": "Directory mounted into the DiscVault Next container that contains discvault.db and media folders."
      },
      {
        "name": "sqliteDb",
        "label": "SQLite database path",
        "type": "text",
        "required": false,
        "placeholder": "/data/discvault.db",
        "description": "Optional explicit path to the legacy DiscVault SQLite database."
      }
    ],
    "secrets": []
  },
  "orderIndex": 5,
  "entitlements": {
    "inspect": "import.source.discvault_legacy.inspect",
    "import": "import.source.discvault_legacy.import"
  }
}
