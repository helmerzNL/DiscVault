{
  "id": "movievault",
  "name": "MovieVault",
  "version": "1.0.0",
  "categories": ["metadata_source", "metadata_receiver"],
  "capabilities": [
    "search_barcode",
    "search_title",
    "movie_details",
    "box_set_candidates",
    "receive_metadata"
  ],
  "requiresSecrets": true,
  "settingsSchemaVersion": 1,
  "settingsSchema": {
    "settings": [
      {
        "name": "baseUrl",
        "label": "MovieVault URL",
        "type": "url",
        "required": false,
        "placeholder": "https://search.discvault.eu"
      }
    ],
    "secrets": [
      {
        "name": "token",
        "label": "MovieVault token",
        "type": "password",
        "required": true
      }
    ]
  },
  "orderIndex": 50,
  "premiumFeatureKey": "metadata.source.movievault.use",
  "entitlements": {
    "source_use": "metadata.source.movievault.use",
    "source_bulk": "metadata.source.movievault.bulk",
    "receiver_contribute": "metadata.receiver.movievault.contribute"
  }
}
