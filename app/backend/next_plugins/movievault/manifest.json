{
  "id": "movievault",
  "name": "MovieVault",
  "version": "1.0.0",
  "categories": ["metadata_source", "metadata_receiver"],
  "capabilities": [
    "search_barcode",
    "search_title",
    "movie_details",
    "box_set_candidates",
    "receive_metadata"
  ],
  "requiresSecrets": false,
  "settingsSchemaVersion": 1,
  "settingsSchema": {
    "settings": [
      {
        "name": "baseUrl",
        "label": "MovieVault search URL",
        "type": "url",
        "required": false,
        "placeholder": "https://search.discvault.eu",
        "description": "MovieVault metadata API base URL."
      },
      {
        "name": "ingestUrl",
        "label": "MovieVault ingest URL",
        "type": "url",
        "required": false,
        "placeholder": "https://movies.discvault.eu",
        "description": "MovieVault connection and contribution API base URL."
      }
    ],
    "secrets": []
  },
  "orderIndex": 50,
  "premiumFeatureKey": "metadata.source.movievault.use",
  "entitlements": {
    "source_use": "metadata.source.movievault.use",
    "source_bulk": "metadata.source.movievault.bulk",
    "receiver_contribute": "metadata.receiver.movievault.contribute"
  }
}
