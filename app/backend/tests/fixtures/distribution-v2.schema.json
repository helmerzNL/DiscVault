{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://movievault.example/contracts/distribution-v2.schema.json",
  "title": "MovieVault anonymous distribution-2 record",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "recordType",
        "operation",
        "revision",
        "releaseId",
        "filmId",
        "canonicalTitle",
        "providerIds",
        "releaseTitle",
        "eanHashes",
        "assets"
      ],
      "properties": {
        "contractVersion": {"const": "distribution-2"},
        "recordType": {"const": "release"},
        "operation": {"const": "upsert"},
        "revision": {"type": "integer", "minimum": 1},
        "releaseId": {"$ref": "#/$defs/uuid"},
        "filmId": {"$ref": "#/$defs/uuid"},
        "canonicalTitle": {"type": "string", "minLength": 1, "maxLength": 500},
        "releaseYear": {"type": ["integer", "null"], "minimum": 1870, "maximum": 2200},
        "providerIds": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "releaseTitle": {"type": "string", "minLength": 1, "maxLength": 500},
        "edition": {"type": ["string", "null"], "maxLength": 255},
        "format": {"type": ["string", "null"], "maxLength": 80},
        "region": {"type": ["string", "null"], "maxLength": 80},
        "countryCode": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}$"
        },
        "languageCode": {"type": ["string", "null"], "maxLength": 35},
        "releaseDate": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "discCount": {"type": ["integer", "null"], "minimum": 1, "maximum": 999},
        "eanHashes": {
          "type": "array",
          "maxItems": 25,
          "items": {"$ref": "#/$defs/hash"}
        },
        "assets": {
          "type": "array",
          "items": {"$ref": "#/$defs/asset"}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "recordType",
        "operation",
        "revision",
        "boxSetId",
        "title",
        "eanHashes",
        "members"
      ],
      "properties": {
        "contractVersion": {"const": "distribution-2"},
        "recordType": {"const": "box_set"},
        "operation": {"const": "upsert"},
        "revision": {"type": "integer", "minimum": 1},
        "boxSetId": {"$ref": "#/$defs/uuid"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "edition": {"type": ["string", "null"], "maxLength": 255},
        "yearRange": {"type": ["string", "null"], "maxLength": 80},
        "format": {"type": ["string", "null"], "maxLength": 80},
        "countryCode": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}$"
        },
        "languageCode": {"type": ["string", "null"], "maxLength": 35},
        "eanHashes": {
          "type": "array",
          "maxItems": 25,
          "items": {"$ref": "#/$defs/hash"}
        },
        "members": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/member"}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "recordType",
        "operation",
        "revision",
        "entityId"
      ],
      "properties": {
        "contractVersion": {"const": "distribution-2"},
        "recordType": {"enum": ["release", "box_set"]},
        "operation": {"const": "delete"},
        "revision": {"type": "integer", "minimum": 1},
        "entityId": {"$ref": "#/$defs/uuid"}
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assetVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "checksum"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/v2/assets/[0-9a-f-]+/(thumbnail|display)$"
        },
        "checksum": {"$ref": "#/$defs/hash"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "assetType",
        "attestation",
        "license",
        "thumbnail",
        "display"
      ],
      "properties": {
        "assetId": {"$ref": "#/$defs/uuid"},
        "assetType": {
          "enum": ["front_cover", "back_cover", "disc", "booklet", "other"]
        },
        "attestation": {"enum": ["original", "licensed"]},
        "license": {"enum": ["cc0-1.0", "cc-by-4.0", "cc-by-sa-4.0"]},
        "thumbnail": {"$ref": "#/$defs/assetVariant"},
        "display": {"$ref": "#/$defs/assetVariant"}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "filmId",
        "canonicalTitle",
        "releaseTitle",
        "eanHashes",
        "position",
        "relationship"
      ],
      "properties": {
        "releaseId": {"$ref": "#/$defs/uuid"},
        "filmId": {"$ref": "#/$defs/uuid"},
        "canonicalTitle": {"type": "string", "minLength": 1, "maxLength": 500},
        "releaseTitle": {"type": "string", "minLength": 1, "maxLength": 500},
        "releaseEdition": {"type": ["string", "null"], "maxLength": 255},
        "format": {"type": ["string", "null"], "maxLength": 80},
        "region": {"type": ["string", "null"], "maxLength": 80},
        "eanHashes": {
          "type": "array",
          "maxItems": 25,
          "items": {"$ref": "#/$defs/hash"}
        },
        "position": {"type": "integer", "minimum": 1},
        "relationship": {"const": "contains"},
        "discNumber": {"type": ["integer", "null"], "minimum": 1, "maximum": 999},
        "discFormat": {"type": ["string", "null"], "maxLength": 80},
        "discBarcodeHash": {
          "oneOf": [
            {"$ref": "#/$defs/hash"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
