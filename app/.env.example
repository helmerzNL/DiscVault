# DiscVault — environment variables
# Copy this file to .env and fill in your values

# Port for the web interface (default 6080)
FRONTEND_PORT=6080

# Port for the MCP SSE server (default 6090)
MCP_PORT=6090

# Build version for the frontend (auto-incremented by scripts/build-with-version.sh)
BUILD_VERSION=dev

# Timezone (used for log timestamps and backup filenames)
TZ=Europe/Amsterdam

# OMDb API key (free at https://www.omdbapi.com/apikey.aspx)
# Provides movie metadata lookups by title or barcode
OMDB_API_KEY=

# TMDb API key (free at https://www.themoviedb.org/settings/api)
# Used as fallback when OMDb returns no results
TMDB_API_KEY=

# MovieVault shared metadata service
# Search is used for metadata lookup; ingest is used for contributions.
MOVIEVAULT_SEARCH_URL=
MOVIEVAULT_INGEST_URL=
MOVIEVAULT_API_TOKEN=
MOVIEVAULT_SHARING_MODE=opt_in

# Authentication (passkey/WebAuthn)
# RP_ID     = domain of your DiscVault instance (no port, no http://)
# RP_ORIGIN = full URL used to access DiscVault
# JWT_SECRET = random string for token signing (auto-generated if left empty)
RP_ID=localhost
RP_ORIGIN=http://localhost:6080
JWT_SECRET=
