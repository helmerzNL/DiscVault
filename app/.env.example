# DiscVault — omgevingsvariabelen
# Kopieer dit bestand naar .env en vul in

# Poort voor de webinterface (standaard 6080)
FRONTEND_PORT=6080

# Poort voor de MCP SSE server (standaard 6090)
MCP_PORT=6090

# Build versie voor de frontend (wordt automatisch verhoogd met scripts/build-with-version.sh)
BUILD_VERSION=dev

# Tijdzone (voor logs/backups)
TZ=Europe/Amsterdam

# OMDb API key (gratis op https://www.omdbapi.com/apikey.aspx)
# Geeft toegang tot filminfo op basis van titel/barcode
OMDB_API_KEY=

# TMDb API key (gratis op https://www.themoviedb.org/settings/api)
# Gebruikt als fallback wanneer OMDb niets vindt
TMDB_API_KEY=

# Authenticatie (passkey/WebAuthn)
# RP_ID = het domein van je DiscVault instance (zonder poort, zonder http://)
# RP_ORIGIN = de volledige URL waarmee je DiscVault benadert
# JWT_SECRET = random string voor token signing (wordt automatisch gegenereerd als leeg)
RP_ID=192.168.100.60
RP_ORIGIN=http://192.168.100.60:6080
JWT_SECRET=
