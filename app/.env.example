# DiscVault — environment variables
# Copy this file to .env and fill in your values

# Port for the web interface (default 6080)
FRONTEND_PORT=6080

# Port for the MCP SSE server (default 6090)
MCP_PORT=6090

# Build version shown in the app. Leave as next-dev to use the version baked into the image.
BUILD_VERSION=next-dev

# DiscVault Next PostgreSQL development stack
# Used by docker-compose.next.yml. Do not reuse production passwords.
POSTGRES_DB=discvault_next
POSTGRES_USER=discvault_next
POSTGRES_PASSWORD=change-me-for-next-dev
DISCVAULT_NEXT_POSTGRES_DATA=./.local/postgres-next
DATABASE_URL=postgresql://discvault_next:change-me-for-next-dev@postgres:5432/discvault_next
DISCVAULT_NEXT_ENABLE_TEST_RESET=false
# Destructive admin dedup execution is disabled unless explicitly enabled.
DISCVAULT_ADMIN_DEDUP_EXECUTE_ENABLED=false

# Keeps DiscVault out of search results and out of AI training corpora: a
# disallow-everything /robots.txt, X-Robots-Tag: noindex on every response, and a
# 403 for known search-engine and AI-crawler user agents. On unless set to false.
DISCVAULT_BLOCK_CRAWLERS=true

# Timezone (used for log timestamps and backup filenames)
TZ=Europe/Amsterdam

# OMDb API key (free at https://www.omdbapi.com/apikey.aspx)
# Provides movie metadata lookups by title or barcode
OMDB_API_KEY=

# TMDb API key (free at https://www.themoviedb.org/settings/api)
# Used as fallback when OMDb returns no results
TMDB_API_KEY=

# MovieVault shared metadata service
# Standard deployments should not need manual tokens. Custom endpoints are for
# non-standard deployments. The handshake secret is temporary for the current
# MovieVault HMAC provider and should disappear once zero-config bootstrap lands.
MOVIEVAULT_SEARCH_URL=https://search.discvault.eu
MOVIEVAULT_INGEST_URL=https://movies.discvault.eu
MOVIEVAULT_DISCVAULT_HANDSHAKE_SECRET=
MOVIEVAULT_SHARING_MODE=opt_in

# Authentication (passkey/WebAuthn)
# RP_ID     = domain of your DiscVault instance (no port, no http://)
# RP_ORIGIN = full URL used to access DiscVault
# JWT_SECRET is required and must remain stable across restarts.
# Generate it once with: openssl rand -base64 48
RP_ID=localhost
RP_ORIGIN=http://localhost:6080
JWT_SECRET=
# Optional separate key for MovieVault credentials encrypted in PostgreSQL.
DISCVAULT_NEXT_KEY_ENCRYPTION_KEY=
# Optional database-backed password + TOTP login. Passkeys remain recommended.
# Existing installs must also enable it in Users & roles with a fresh passkey.
LEGACY_AUTH_ENABLED=false
# Which hops may state a client address on someone else's behalf.
# Empty means none: forwarding headers are ignored and every request is
# attributed to the address the server itself observed. Set this when DiscVault
# runs behind a reverse proxy, or the audit trail records the proxy for every
# user and the per-client login throttles all share one bucket.
# Accepts IPs and CIDRs, comma-separated, plus the keyword "private" for the
# usual case of a proxy on your own LAN (127/8, 10/8, 172.16/12, 192.168/16,
# link-local and their IPv6 equivalents).
# Example: DISCVAULT_TRUSTED_PROXIES=private
DISCVAULT_TRUSTED_PROXIES=
