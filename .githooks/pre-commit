#!/usr/bin/env sh
# DiscVault: reject purged iOS artifacts, then keep app/VERSION in step with
# app/runtime changes so the CI guards pass.
#
# Enable once per clone:
#   git config core.hooksPath .githooks

if command -v python >/dev/null 2>&1; then
  PYTHON=python
elif command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
else
  echo "DiscVault pre-commit failed: Python is required for repository guards." >&2
  exit 1
fi

"$PYTHON" app/scripts/check_forbidden_paths.py --staged || exit $?
"$PYTHON" app/scripts/bump_version.py || true

exit 0
