#!/usr/bin/env sh
# DiscVault: reject purged iOS artifacts.
#
# This hook used to bump app/VERSION as well. It must not: the bump is applied by
# CI on release/v26-beta after the merge, and a pull request that carries a bump is
# now refused by the version guard. Bumping here would make every commit fail the
# check it was meant to satisfy.
#
# Enable once per clone:
#   git config core.hooksPath .githooks

if command -v python >/dev/null 2>&1; then
  PYTHON=python
elif command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
else
  echo "DiscVault pre-commit failed: Python is required for repository guards." >&2
  exit 1
fi

"$PYTHON" app/scripts/check_forbidden_paths.py --staged || exit $?

exit 0
