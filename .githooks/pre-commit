#!/usr/bin/env sh
# DiscVault: reject purged iOS artifacts, and keep the agent instruction
# surfaces consistent.
#
# This hook used to bump app/VERSION as well. It must not: the bump is applied by
# CI on release/v26-beta after the merge, and a pull request that carries a bump is
# now refused by the version guard. Bumping here would make every commit fail the
# check it was meant to satisfy.
#
# Enable once per clone:
#   git config core.hooksPath .githooks

if command -v python >/dev/null 2>&1; then
  PYTHON=python
elif command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
else
  echo "DiscVault pre-commit failed: Python is required for repository guards." >&2
  exit 1
fi

"$PYTHON" app/scripts/check_forbidden_paths.py --staged || exit $?

# Also in CI, as `agent-instructions-lint`. Both, not either: CI is too late for
# this one. By the time it reports, the commit exists and the counterpart edit --
# deleting the line that was just copied into a pointer file, or fixing the link
# that moved -- is no longer the obvious next thing to do.
#
# It reads three markdown files, so it costs nothing to run on every commit.
"$PYTHON" scripts/check_agent_instructions.py || exit $?

exit 0
