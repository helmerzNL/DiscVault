+
+    private var backdropPlaceholder: some View {
+        LinearGradient(
+            colors: [Color(red: 0.15, green: 0.1, blue: 0.3), Color(red: 0.06, green: 0.06, blue: 0.14)],
+            startPoint: .top, endPoint: .bottom
+        )
