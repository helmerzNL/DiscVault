+
+    // MARK: - Plot
+
+    private func plotSection(vm: MovieDetailViewModel) -> some View {
+        Group {
+            if let plot = vm.movie.plot, !plot.isEmpty {
+                VStack(alignment: .leading, spacing: 8) {
+                    Text("Plot")
+                        .font(.headline)
+                        .foregroundStyle(.white)
+                    Text(plot)
+                        .font(.subheadline)
+                        .foregroundStyle(.white.opacity(0.7))
+                        .lineSpacing(4)
+                }
+            }
+        }
